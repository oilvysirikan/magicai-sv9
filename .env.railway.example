APP_NAME="MagicAI"
APP_ENV=production
APP_KEY=generate-secure-key-here
APP_DEBUG=false
APP_URL=https://your-app.railway.app

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Railway Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=${RAILWAY_MYSQL_HOST}
DB_PORT=3306
DB_DATABASE=${RAILWAY_MYSQL_DATABASE}
DB_USERNAME=${RAILWAY_MYSQL_USERNAME}
DB_PASSWORD=${RAILWAY_MYSQL_PASSWORD}

# Redis (via Railway)
REDIS_HOST=${RAILWAY_REDIS_HOST}
REDIS_PASSWORD=${RAILWAY_REDIS_PASSWORD}
REDIS_PORT=6379

# Cache & Session
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_LIFETIME=120

# Broadcasting
BROADCAST_DRIVER=log

# Cloudflare R2 Storage (S3-compatible)
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_DEFAULT_REGION=auto
CLOUDFLARE_R2_BUCKET=your-r2-bucket-name
CLOUDFLARE_R2_URL=https://your-r2-bucket-url.r2.dev
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=true
CLOUDFLARE_R2_VISIBILITY=public

# Fallback AWS S3 (if needed)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Vite
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Sentry (optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Additional Service Keys (if used)
GOOGLE_CLOUD_API_KEY=
OPENAI_API_KEY=
STRIPE_KEY=
STRIPE_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=