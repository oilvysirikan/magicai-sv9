{% render 'peaches-theme-vars' %}

<style>
  #shopify-section-{{ section.id }} section{padding:56px 0;border-bottom:1px solid var(--pa-line);}
  #shopify-section-{{ section.id }} .section-row{display:grid;grid-template-columns:0.8fr 3.2fr;gap:24px;align-items:start;}
  #shopify-section-{{ section.id }} .section-head h2{font-size:28px;font-weight:600;line-height:1.15;margin-bottom:10px;}
  #shopify-section-{{ section.id }} .section-head p{font-size:13px;color:var(--pa-muted);margin-bottom:14px;line-height:1.6;max-width:220px;}
  #shopify-section-{{ section.id }} .fabric-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:14px;}
  #shopify-section-{{ section.id }} .fabric-item{text-align:center;}
  #shopify-section-{{ section.id }} .fabric-item svg{margin:0 auto 12px;stroke:var(--pa-ink);}
  #shopify-section-{{ section.id }} .fabric-item .t{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.02em;margin-bottom:3px;}
  #shopify-section-{{ section.id }} .fabric-item .th{font-size:10px;color:var(--pa-muted);}
  @media (max-width:980px){
    #shopify-section-{{ section.id }} .fabric-grid{grid-template-columns:repeat(3,1fr);row-gap:22px;}
    #shopify-section-{{ section.id }} .section-row{grid-template-columns:1fr;}
  }
</style>

<section>
  <div class="pa-wrap">
    <div class="section-row">
      <div class="section-head">
        <h2 class="pa-display">{{ section.settings.heading | default: 'Seven Fabric Technology' }}</h2>
        <p>{{ section.settings.subheading | default: 'Engineered for performance. Designed for comfort.' }}</p>
        {% if section.settings.link_label != blank %}
          <a href="{{ section.settings.link_url }}" class="pa-btn-text">{{ section.settings.link_label }} →</a>
        {% endif %}
      </div>
      <div class="fabric-grid">
        {% for block in section.blocks %}
          {% if block.type == 'fabric' %}
            <div class="fabric-item" {{ block.shopify_attributes }}>
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke-width="1.4"><circle cx="12" cy="12" r="9"/></svg>
              <div class="t">{{ block.settings.title_en }}</div>
              <div class="th">{{ block.settings.title_th }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fabric Technology",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seven Fabric Technology" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Engineered for performance. Designed for comfort." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover More" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "fabric",
      "name": "Fabric feature",
      "settings": [
        { "type": "text", "id": "title_en", "label": "Title (English)", "default": "Soft & Smooth" },
        { "type": "text", "id": "title_th", "label": "Title (Thai)", "default": "เนื้อผ้านุ่มลื่น" }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [
    {
      "name": "Fabric Technology",
      "blocks": [
        { "type": "fabric", "settings": { "title_en": "Soft & Smooth", "title_th": "เนื้อผ้านุ่มลื่น" } },
        { "type": "fabric", "settings": { "title_en": "4-Way Stretch", "title_th": "ยืดหยุ่น 4 ทิศทาง" } },
        { "type": "fabric", "settings": { "title_en": "Breathable", "title_th": "ระบายอากาศดี" } },
        { "type": "fabric", "settings": { "title_en": "Sweat-Wicking", "title_th": "ซับเหงื่อเร็ว" } },
        { "type": "fabric", "settings": { "title_en": "Quick Dry", "title_th": "แห้งไว" } },
        { "type": "fabric", "settings": { "title_en": "UV Protection", "title_th": "ป้องกันยูวี" } },
        { "type": "fabric", "settings": { "title_en": "Shape Retention", "title_th": "คงรูปทรง" } }
      ]
    }
  ]
}
{% endschema %}
